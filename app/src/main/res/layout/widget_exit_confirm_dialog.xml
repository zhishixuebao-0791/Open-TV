<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_loading_panel"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tvExitConfirmMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/exit_confirm_message"
        android:textColor="#EAF4FF"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="68dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_channel_option"
            android:gravity="center"
            android:minWidth="0dp"
            android:text="@string/cancel"
            android:textColor="#EAF4FF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnConfirmExit"
            android:layout_width="68dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_channel_option"
            android:gravity="center"
            android:minWidth="0dp"
            android:text="@string/confirm"
            android:textColor="#EAF4FF"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>


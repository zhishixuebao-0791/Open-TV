<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_side_panel_right">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/video_source"
                android:textColor="#F2F7FF"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/llSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSourcePrev"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="0.78"
                    android:background="@drawable/bg_source_arrow"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="&#x25C0;"
                    android:textAllCaps="false"
                    android:textColor="#9EEBFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvSourceCurrent"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="2.25"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_source_center"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="&#x7EBF;&#x8DEF;1"
                    android:textColor="#EAF4FF"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSourceNext"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="0.78"
                    android:background="@drawable/bg_source_arrow"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="&#x25B6;"
                    android:textAllCaps="false"
                    android:textColor="#9EEBFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/aspect_ratio"
                android:textColor="#F2F7FF"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/rbAspectRatio_16_9"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_channel_option"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:text="16:9"
                    android:textColor="#EAF4FF"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/rbAspectRatio_4_3"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_channel_option"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:text="4:3"
                    android:textColor="#EAF4FF"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/video_size"
                android:textColor="#F2F7FF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvVideoSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_channel_progress_pill"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="0x0"
                android:textColor="#ECF6FF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnAppSettings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_channel_option"
                android:text="@string/app_settings"
                android:textColor="#EAF4FF"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="0"
                android:startColor="#8033B8FF"
                android:endColor="#8042E5B9" />
            <stroke
                android:width="1dp"
                android:color="#B3CDEBFF" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="0"
                android:startColor="#6628A8FF"
                android:endColor="#6638CFA8" />
            <stroke
                android:width="2dp"
                android:color="#E6D9F1FF" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="0"
                android:startColor="#6632A7FF"
                android:endColor="#6631D7A5" />
            <stroke
                android:width="1dp"
                android:color="#A8D6F7FF" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#1FFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#66C5D9F2" />
        </shape>
    </item>
</selector>

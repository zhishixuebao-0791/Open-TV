<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="0"
                android:startColor="#2E3EA8FF"
                android:endColor="#2E2CCFA8" />
            <stroke
                android:width="2dp"
                android:color="#D8EBFF" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="0"
                android:startColor="#3339A4FF"
                android:endColor="#332FD6A0" />
            <stroke
                android:width="1dp"
                android:color="#80B8E4FF" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#1AFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#33BCD8F2" />
        </shape>
    </item>
</selector>
